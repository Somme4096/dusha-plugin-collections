{
  "host": "0.0.0.0",
  "port": 8765,
  "timezone": "Asia/Taipei",
  "api_token": "change-me-device-token",
  "plugins_dir": "/path/to/dusha-plugin-collections",
  "plugins": {
    "identity": {
      "disabled": true
    },
    "memory": {
      "disabled": true
    },
    "evergreen": {
      "disabled": true
    },
    "memo": {
      "disabled": true
    },
    "affect": {
      "disabled": true
    },
    "proactive": {
      "disabled": true
    },
    "presence": {
      "options": {
        "device": "macbook",
        "report_to": "proxy",
        "interval_seconds": 30
      }
    },
    "notification": {
      "options": {
        "device": "macbook"
      }
    },
    "ambient": {
      "options": {
        "device": "macbook",
        "forward_to": "proxy",
        "sample_seconds": 60,
        "screen": {
          "provider": "opencode-go",
          "model": "muse-spark-1.3-contributor",
          "every_seconds": 30,
          "extra_body": {
            "reasoning_effort": "minimal"
          }
        },
        "packages": {},
        "browser": {
          "profiles": {
            "zen:Somme4096": "personal",
            "chrome:Default": "work"
          }
        },
        "files": {}
      }
    }
  },
  "proxy": {
    "server": {
      "url": "http://nas:8765",
      "token": "change-me-hub-token"
    }
  },
  "providers": {
    "opencode-go": {
      "base_url": "https://opencode.ai/inference/go/v1",
      "key": "{env:OPENCODE_API_KEY}",
      "headers": {
        "x-opencode-session": "{conversation_id}"
      }
    }
  }
}
